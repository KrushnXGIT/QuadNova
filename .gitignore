# ============================================================
# Dataset files
# ============================================================

# Raw and generated datasets should generally not be committed
# until their size, licence, and storage strategy are verified.

data/raw/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# ============================================================
# Generated results
# ============================================================

results/temp/
results/cache/

# Keep directory
!results/.gitkeep

# ============================================================
# Model directory
# ============================================================

models/*
!models/.gitkeep