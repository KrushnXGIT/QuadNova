APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Existing AI model checkpoint, relative to backend/.
# Do not copy the checkpoint into backend/.
AI_MODEL_PATH=../ai_model/models/hb_regressor_best.pt
AI_DEVICE=cpu

# Comma-separated list of allowed CORS origins.
# For local Android physical device use your machine's LAN IP.
# Example: ALLOWED_ORIGINS=http://192.168.1.10:8000,http://10.0.2.2:8000
ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000

# Maximum image upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Minimum confidence threshold — predictions below this are LOW_CONFIDENCE.
CONFIDENCE_THRESHOLD=0.70

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
